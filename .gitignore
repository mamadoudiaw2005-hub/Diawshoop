# ─────────────────────────────────────────────────────────────────
# DIAW SHOOP — .gitignore
# Fichiers à ne JAMAIS versionner dans Git/GitHub
# ─────────────────────────────────────────────────────────────────

# Variables d'environnement et secrets
.env
.env.*
!.env.example

# Contrats privés et documents confidentiels
CONTRAT_*.md
*.pdf
assets/*.pdf

# Scripts SQL internes et sauvegardes de base de données
*.sql

# Logs et données persistantes du serveur
server_orders.json
*.log
logs/

# Environnement Python et Cache
server.py
requirements.txt
scratch/
__pycache__/
.cache/
*.py[cod]
*.pyo
*.pyd
venv/
env/
.venv/
*.egg-info/
dist/
build/
node_modules/

# Système
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp
*.swo
